{
    "workbench.colorTheme": "ODIVM Graphite",
    "workbench.iconTheme": "catppuccin-mocha",
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "diffEditor.codeLens": true,
    "excalidraw.theme": "auto",
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
    "claudeCode.preferredLocation": "sidebar",
    "claudeCode.allowDangerouslySkipPermissions": true,
    "claudeCode.initialPermissionMode": "bypassPermissions",
    "claudeCode.hideOnboarding": true,
    "python.languageServer": "None",
    "telemetry.telemetryLevel": "off",
    "telemetry.feedback.enabled": false,
    "workbench.enableExperiments": false,
    "workbench.settings.enableNaturalLanguageSearch": false,
    "chat.disableAIFeatures": true,
    "npm.fetchOnlinePackageInfo": false,
    "update.mode": "none",
    "redhat.telemetry.enabled": false,
    "dotnetAcquisitionExtension.enableTelemetry": false,
    "gitlens.ai.enabled": false,
    "gitlens.plusFeatures.enabled": false,
    "gitlens.cloudPatches.enabled": false,
    "workbench.preferredDarkColorTheme": "ODIVM Graphite",
    "editor.fontFamily": "'Geist Mono', 'GeistMono Nerd Font', monospace",
    "editor.fontSize": 13,
    "editor.lineHeight": 1.6,
    "editor.fontWeight": "400",
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.renderLineHighlight": "all",
    "terminal.integrated.fontFamily": "'GeistMono Nerd Font'",
    "terminal.integrated.fontSize": 13,
    "workbench.tree.indent": 14,
    "catppuccin-icons.monochrome": true
}
